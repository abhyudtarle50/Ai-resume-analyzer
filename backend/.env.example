# Flask Environment
FLASK_ENV=production
SECRET_KEY=generate-a-random-hex-string-here

# API Keys
SARVAM_API_KEY=your_sarvam_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database
# For Render/Railway, you can use the default or a PostgreSQL URL
DATABASE_URL=sqlite:///database/resume_analyzer.db

# CORS Settings
# The URL of your deployed React frontend
CORS_ORIGINS=https://ai-resume-analyzer-isrf.vercel.app
